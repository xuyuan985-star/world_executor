# 环境变量（禁止提交；.env.example 是模板需入库）
.env
*.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
m7_venv/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 运行时状态
runtime.db
runtime.db-*
*.sqlite3

# 内化的 March7th 源码（66.8MB 第三方代码——不入库，运行时必须有；
# 缺失时可用 tools/setup_m7.py 或从官方仓库拷贝）
m7/

# 运行时日志/快照/报告（不入库）
logs/
reports/
dump/

# 运行时失败记忆（FailureMemory 持久化，同 runtime.db 属运行时状态）
memory/
ingest/raw/events/*.jsonl

# 原始视频/中间产物
攻略视频/
ingest/raw/frames/
ingest/raw/events/*.json
ingest/raw/videos/
ingest/tmp/
ingest/raw/analysis/

# 密钥与本地配置
settings.local.json

# 企划/报告（不入库，仅本地）
docs/企划书-*.md
docs/阶段报告-*.md
docs/变更与问题报告.md
failure_reports/

# IDE
.idea/
.vscode/
