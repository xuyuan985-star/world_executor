# =========================================================
# WorldExecutor 环境配置模板
# 使用：复制本文件为 .env 后填写（.env 不入库，勿提交真实 key）
#   Windows:  copy .env.example .env
#   Linux:    cp .env.example .env
# =========================================================

# 通义千问 API Key（VLM 分析/攻略识别用；模板匹配路径不需要也能跑）
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-max
QWEN_VLM_ANALYZE_MODEL=qwen3-vl-plus
QWEN_VLM_STRUCTURE_MODEL=qwen-max

# 降级模型（逗号分隔，主模型失败时按序尝试）
QWEN_VLM_FALLBACK=
QWEN_TEXT_FALLBACK=

# GUI 默认加载的地图（可选）
# DEFAULT_MAP=02_herta_space_station

# VLM 全局限流（次/分钟，0=不限；多线程共享防 API rate limit）
# VLM_RATE_PER_MIN=20

# 模板匹配置信度阈值（0-1，可选）
# TEMPLATE_THRESHOLD=0.60

# B站 cookie（可选，下载攻略视频用；也可存入 Windows 凭据管理器）
# BILIBILI_COOKIE=SESSDATA=xxx
# BILI_STORE_CREDENTIAL=true
